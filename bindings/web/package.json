{
  "name": "@decentdb/web",
  "version": "3.0.0",
  "description": "Web binding scaffold for DecentDB via browser worker + WASM runtime",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "src/",
    "tests/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "browser:install": "playwright install chromium",
    "browser:install:ci": "playwright install --with-deps chromium",
    "browser:install:matrix": "playwright install chromium chrome firefox",
    "browser:bench": "playwright test --config ../../tests/bindings/web/playwright.bench.config.js",
    "browser:smoke": "playwright test --config ../../tests/bindings/web/playwright.config.js",
    "browser:smoke:chrome": "DDB_WEB_INCLUDE_CHROME=1 playwright test --config ../../tests/bindings/web/playwright.config.js",
    "browser:smoke:edge": "DDB_WEB_INCLUDE_EDGE=1 playwright test --config ../../tests/bindings/web/playwright.config.js",
    "browser:smoke:candidate": "playwright test --config ../../tests/bindings/web/playwright.candidate.config.js",
    "browser:guardrails": "npm run browser:bench",
    "smoke": "npm run browser:smoke",
    "smoke:manual": "echo \"Manual browser smoke remains at tests/bindings/web/smoke.html and is covered via browser:smoke\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "browser:smoke:ci": "playwright test --config ../../tests/bindings/web/playwright.config.js --reporter=dot"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "packageManager": "npm@12.2.0"
}
